@@ -85,8 +85,24 @@ REG csr_reg[] = {
     { NULL }
 };
 
+/* att3b2: emulate the front-panel power switch. Raising the Power Down Request
+   interrupt (IPL 15) is what the real switch does; UNIX syncs, prints "Soft power
+   switch shutdown" and writes CSRPWRSPDN, which stops the simulator (STOP_POWER). */
+static t_stat csr_set_powerdown(UNIT *uptr, int32 val, CONST char *cptr, void *desc)
+{
+    CSRBIT(CSRPWRDN, TRUE);
+    CPU_SET_INT(INT_PWRDWN);
+    return SCPE_OK;
+}
+
+MTAB csr_mod[] = {
+    { MTAB_XTD|MTAB_VDV, 0, NULL, "POWERDOWN",
+      &csr_set_powerdown, NULL, NULL, "Press the front-panel power switch (clean shutdown)" },
+    { 0 }
+};
+
 DEVICE csr_dev = {
-    "CSR", &csr_unit, csr_reg, NULL,
+    "CSR", &csr_unit, csr_reg, csr_mod,
     1, 16, 8, 4, 16, 32,
     &csr_ex, &csr_dep, &csr_reset,
     NULL, NULL, NULL, NULL,
